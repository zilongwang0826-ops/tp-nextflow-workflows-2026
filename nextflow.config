docker {
    enabled = true
    runOptions = "--entrypoint=''"
}

report {
    enabled = true
    overwrite = true
    file = 'reports/report.html'
}

trace {
    enabled = true
    overwrite = true
    file = 'reports/trace.txt'
}

timeline {
    enabled = true
    overwrite = true
    file = 'reports/timeline.html'
}

dag {
    enabled = true
    overwrite = true
    file = 'reports/dag.dot'
}

process {
    executor = 'local'
    scratch = false
    maxRetries = 30
    errorStrategy = 'retry'

    withName: downloadTree {
        cpus = 1
        memory = "1G"
        time = "2m"
        container = "evolbioinfo/ubuntu:v24.04"
    }

    withName: listTips {
        cpus = 1
        memory = "1G"
        time = "30s"
        container = "evolbioinfo/gotree:v0.4.1a"
    }
}
